        "27": {
            "annotation": "BRANCH A — Read-based ARG detection (fast, high sensitivity, no assembly). GROOT classifies reads directly against ARG variation graphs via LSH-forest k-mer search + local alignment (Rowe & Winn 2018, doi:10.1093/bioinformatics/bty387). windowSize=150 to match this dataset's actual read length (NovaSeq PE150, same length used by the Bracken step) per GROOT's own recommendation (index window ~= max read length). Database: arg-annot (90% identity), the only groot_database installed on usegalaxy.eu. Output gene IDs are in ARG-ANNOT's own nomenclature; normalized to CARD AMR Gene Family in the next step for comparability with Branch B/C. [2026-07-10 fix: switched from covCutoff=0.97 to --lowCov. GROOT's own tutorial only documents a binary real-data choice (-c 1 strict full-length vs --lowCov for genes not covered at the 5'/3' ends) — no fractional cutoff is demonstrated for real (non-toy) data. Real soil metagenomic coverage is uneven, matching exactly the scenario GROOT's own tutorial used --lowCov for.]",
            "content_id": "toolshed.g2.bx.psu.edu/repos/iuc/groot/groot/1.1.2+galaxy2",
            "errors": null,
            "id": 27,
            "input_connections": {
                "fastq": {
                    "id": 26,
                    "output_name": "output"
                }
            },
            "inputs": [],
            "label": "GROOT (Branch A: reads-based ARG detection)",
            "name": "Groot",
            "outputs": [
                {
                    "name": "report_out",
                    "type": "tabular"
                }
            ],
            "position": {
                "left": 960,
                "top": 400
            },
            "post_job_actions": {
                "RenameDatasetActionreport_out": {
                    "action_type": "RenameDatasetAction",
                    "output_name": "report_out",
                    "action_arguments": {
                        "newname": "IPK2026_27_GROOT_raw_result.tabular"
                    }
                }
            },
            "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/groot/groot/1.1.2+galaxy2",
            "tool_shed_repository": {
                "changeset_revision": "",
                "name": "groot",
                "owner": "iuc",
                "tool_shed": "toolshed.g2.bx.psu.edu"
            },
            "tool_state": "{\"fastq\": {\"__class__\": \"ConnectedValue\"}, \"index\": {\"groot_db_select\": \"arg-annot.90-1.1.2-09122024\", \"windowSize\": \"150\", \"kmerSize\": \"31\", \"maxK\": \"4\", \"maxSketchSpan\": \"4\", \"numPart\": \"8\", \"sketchSize\": \"21\"}, \"align\": {\"contThresh\": \"0.99\", \"minKmerCov\": \"1\", \"noAlign\": true}, \"report\": {\"coverage\": {\"mode\": \"lowcov\", \"__current_case__\": 1}}, \"__page__\": null, \"__rerun_remap_job_id__\": null}",
            "tool_uuid": null,
