        "36": {
            "annotation": "2026-07-22 fix: filter out antiSMASH's whole-assembly artifact ('input_tempfile') from the 'genbank' collection before it reaches BiG-SCAPE/ABRicate. [2026-07-23 fix: confirmed via direct Galaxy API inspection (dataset_collections endpoint) that antiSMASH's 'genbank' output is actually collection_type='list:list' — an OUTER level with exactly 1 element (named after the sample, e.g. 'SRR14689470', from implicit collection mapping since MEGAHIT's single-sample output still traces back through Step 1's list:paired wrapping), and an INNER level holding the real per-BGC-region files. The first version of this rule used 'identifier0' (the OUTER, sample-level identifier — identical for every row) instead of 'identifier1' (the INNER, per-region identifier), so every row collapsed to the same identifier and the rule engine kept only one merged element. Fixed to use 'identifier1'.]",
            "content_id": "__APPLY_RULES__",
            "errors": null,
            "id": 36,
            "input_connections": {
                "input": {
                    "id": 14,
                    "output_name": "genbank"
                }
            },
            "inputs": [],
            "label": "Filter out antiSMASH whole-assembly artifact",
            "name": "Apply rules",
            "outputs": [],
            "position": {
                "left": 1440,
                "top": 1100
            },
            "post_job_actions": {},
            "tool_id": "__APPLY_RULES__",
            "tool_state": "{\"input\": {\"__class__\": \"ConnectedValue\"}, \"rules\": {\"rules\": [{\"type\": \"add_column_metadata\", \"value\": \"identifier1\"}, {\"type\": \"add_filter_regex\", \"target_column\": 0, \"expression\": \"^input_tempfile$\", \"invert\": true}], \"mapping\": [{\"type\": \"list_identifiers\", \"columns\": [0]}]}, \"__page__\": null, \"__rerun_remap_job_id__\": null}",
