        "37": {
            "annotation": "PRE-FILTER for antiSMASH only (Branch B ABRicate still uses raw MEGAHIT output unfiltered). MEGAHIT metagenome assemblies contain a huge long tail of very short contigs (~67-72% under 1000bp in this pipeline's real runs) that antiSMASH's own --minlength 1000 would skip anyway, but which still cost parse/gene-finding overhead at scale (GL56 samples: ~800K-1.07M total contigs vs 314K in the original demo run). This step removes them upstream so antiSMASH only ever sees records it would actually analyze, cutting per-record overhead without changing which contigs antiSMASH ultimately scans (matches antiSMASH's own minlength=1000 exactly). Added 2026-08-04 after confirming (via contig header length distribution) that GL56_UP1/UP2's multi-day antiSMASH runtime correlates with 2.7-4x more usable (>=1000bp) contigs than the original run, not a broken tool/server (verified via a live health-check job that completed in 41s).",
            "content_id": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_awk_tool/1.1.2",
            "errors": null,
            "id": 37,
            "input_connections": {
                "infile": {
                    "id": 7,
                    "output_name": "output"
                }
            },
            "inputs": [],
            "label": "Pre-filter MEGAHIT contigs >=1000bp (for antiSMASH)",
            "name": "Text reformatting with awk",
            "outputs": [
                {
                    "name": "outfile",
                    "type": "input"
                }
            ],
            "position": {
                "left": 960,
                "top": 1100
            },
            "post_job_actions": {
                "RenameDatasetActionoutfile": {
                    "action_type": "RenameDatasetAction",
                    "output_name": "outfile",
                    "action_arguments": {
                        "newname": "IPK2026_37_MEGAHIT_1kb_filtered.fasta"
                    }
                }
            },
            "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_awk_tool/1.1.2",
